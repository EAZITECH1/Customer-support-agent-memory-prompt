# ─────────────────────────────────────────────────────────────
# eazitech-support-chat  —  copy this file to `.env` and fill in.
# `.env` is gitignored. Never put these values in front-end code.
# ─────────────────────────────────────────────────────────────

# ── Model provider (OpenAI-compatible /v1/chat/completions) ──
# The base URL must be the OpenAI-compatible root that exposes /chat/completions.
# Examples (uncomment/edit ONE):
#   Ollama (local):     http://localhost:11434/v1
#   LM Studio (local):  http://localhost:1234/v1
#   OpenRouter:         https://openrouter.ai/api/v1
#   Groq:               https://api.groq.com/openai/v1
#   Together:           https://api.together.xyz/v1
LLM_BASE_URL=

# API key for the provider above. For a local server with no auth, put any
# non-empty placeholder (e.g. "local").
LLM_API_KEY=

# Model id, as your provider names it. Examples:
#   Ollama:      llama3.1  |  qwen2.5  |  mistral
#   OpenRouter:  anthropic/claude-3.5-sonnet  |  openai/gpt-4o-mini
#   Groq:        llama-3.3-70b-versatile
LLM_MODEL=

# Optional model knobs
LLM_TEMPERATURE=0.3
# Max model<->tool round-trips per user message before we force a final answer.
LLM_MAX_TOOL_ROUNDS=6

# ── MemWal (Walrus Memory) ──
# The support chat uses its OWN Sui wallet, separate from the machine's ~/.memwal.
# The wallet credential (base64 of a memwal credentials.json, INCLUDING the
# delegate private key) lives here in .env and is the single source of truth.
# The backend writes it into an isolated project-local HOME at boot; your main
# ~/.memwal login is never touched.
#
# Easiest way to fill this in — log in the NEW wallet and auto-capture it:
#   npm run memwal:login
# (opens a browser; connect the support wallet; it writes MEMWAL_CREDENTIALS_JSON
#  below for you). Leave it blank until then; the app boots but memory is offline.
MEMWAL_CREDENTIALS_JSON=

# Fallback namespace used only when the model/system-prompt omits one on a call.
# (The support-bot-prompt.md drives per-area namespaces like resolved-billing.)
MEMWAL_NAMESPACE=support

# npm spec used only if @mysten-incubation/memwal-mcp isn't installed locally:
MEMWAL_MCP_SPEC=@mysten-incubation/memwal-mcp@0.0.7

# ── Server ──
PORT=8787
